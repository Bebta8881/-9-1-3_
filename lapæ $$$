#subscription-userinfo: upload=0; download=0; total=0 expire=1826928000

{
  "log": {
    "loglevel": "error"
  },
  "inbounds": [
    {
      "tag": "in-s3k1gl",
      "port": 10808,
      "listen": "127.0.0.1",
      "protocol": "mixed",
      "settings": {
        "auth": "noauth",
        "udp": true
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "routeOnly": true
      }
    }
  ],
  "outbounds": [
    {
      "tag": "proxy",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "fast_s57.slopllex.app",
            "port": 443,
            "users": [
              {
                "id": "a5a1edb7-48fd-44c5-8e5b-aa707dafe0ca",
                "encryption": "none",
                "level": 8,
                "flow": "xtls-rprx-vision"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "tls",
        "tlsSettings": {
          "serverName": "fast_s57.slopllex.app",
          "fingerprint": "edge"
        },
        "finalmask": {
          "type": "fragment",
          "settings": {
            "packets": "tlshello",
            "lengths": [
              "3-5",
              "6-8",
              "10-20"
            ],
            "delays": [
              "10-20"
            ],
            "maxSplit": "3-6"
          }
        }
      }
    },
    {
      "tag": "direct",
      "protocol": "freedom",
      "settings": {
        "ipsBlocked": []
      }
    },
    {
      "tag": "block",
      "protocol": "blackhole",
      "settings": {}
    },
    {
      "tag": "dns-out",
      "protocol": "dns"
    }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "port": "53",
        "outboundTag": "dns-out",
        "type": "field"
      },
      {
        "ip": [
          "10.0.0.2",
          "198.18.0.2",
          "fd6e:a81b:704f:1211::2"
        ],
        "outboundTag": "dns-out",
        "type": "field"
      },
      {
        "network": "tcp",
        "port": "853",
        "outboundTag": "proxy",
        "type": "field"
      },
      {
        "inboundTag": [
          "domestic_dns"
        ],
        "outboundTag": "direct",
        "type": "field"
      },
      {
        "inboundTag": [
          "wg_bootstrap_dns"
        ],
        "outboundTag": "direct",
        "type": "field"
      },
      {
        "inboundTag": [
          "dns"
        ],
        "outboundTag": "proxy",
        "type": "field"
      }
    ]
  },
  "dns": {
    "queryStrategy": "UseIP",
    "servers": [
      "1.1.1.1",
      "8.8.8.8"
    ]
  },
  "policy": {
    "levels": {
      "8": {
        "connIdle": 300,
        "downlinkOnly": 4,
        "handshake": 3,
        "uplinkOnly": 2,
        "bufferSize": 3,
        "statsUserDownlink": false,
        "statsUserUplink": false,
        "statsUserOnline": false
      }
    },
    "system": {
      "statsInboundDownlink": true,
      "statsInboundUplink": true,
      "statsOutboundDownlink": true,
      "statsOutboundUplink": true
    }
  },
  "stats": {}
}
